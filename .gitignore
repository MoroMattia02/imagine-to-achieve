# Pinned environment built by scripts/create_env.sh
.venv_aarch64/
.venv*/

# Run outputs: checkpoints, metrics, analysis, figures
outputs/
analysis/*/
*.png
*.pdf
*.dat

# Model weights and data — never committed
*.pth
*.ckpt
*.safetensors
*.bin
*.npy
*.npz

# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/

# Docs build outputs: MkDocs site, LaTeX intermediates of docs/book (book.pdf is built by CI)
site/
docs/book/*.aux
docs/book/*.fdb_latexmk
docs/book/*.fls
docs/book/*.log
docs/book/*.out
docs/book/*.synctex.gz
docs/book/*.toc
docs/book/chapters/*.aux

# Slurm
slurm-*.out
*.err

# OS
.DS_Store
Thumbs.db
